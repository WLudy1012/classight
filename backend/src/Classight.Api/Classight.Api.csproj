<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <InternalsVisibleTo Include="Classight.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Classight.Identity/Classight.Identity.csproj" />
    <ProjectReference Include="../Classight.Class/Classight.Class.csproj" />
    <ProjectReference Include="../Classight.Content/Classight.Content.csproj" />
    <ProjectReference Include="../Classight.SiteAdmin/Classight.SiteAdmin.csproj" />
    <ProjectReference Include="../Classight.Plugins/Classight.Plugins.csproj" />
    <ProjectReference Include="../Classight.Speech/Classight.Speech.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="../Classight.Captcha/Classight.Captcha.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="../Classight.Timetable/Classight.Timetable.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="../Classight.MemberIdentity/Classight.MemberIdentity.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Classight.Speech/bin/$(Configuration)/$(TargetFramework)/Classight.Speech.dll" LogicalName="Classight.BuiltinPlugins.Classight.Speech.dll" />
    <EmbeddedResource Include="../Classight.Captcha/bin/$(Configuration)/$(TargetFramework)/Classight.Captcha.dll" LogicalName="Classight.BuiltinPlugins.Classight.Captcha.dll" />
    <EmbeddedResource Include="../Classight.Timetable/bin/$(Configuration)/$(TargetFramework)/Classight.Timetable.dll" LogicalName="Classight.BuiltinPlugins.Classight.Timetable.dll" />
    <EmbeddedResource Include="../Classight.MemberIdentity/bin/$(Configuration)/$(TargetFramework)/Classight.MemberIdentity.dll" LogicalName="Classight.BuiltinPlugins.Classight.MemberIdentity.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(ClassightStandalone)' == 'true'">
    <EmbeddedResource Include="$(ClassightFrontendArchive)" LogicalName="Classight.Frontend.zip" />
    <EmbeddedResource Include="appsettings.json" LogicalName="Classight.DefaultSettings.json" />
    <Content Update="appsettings.json;appsettings.Local.json;appsettings.Local.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
